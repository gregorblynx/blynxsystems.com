# Copy to .env for local builds. Never commit the real .env.
# Both values are also required in the Vercel project's Environment Variables.

# Google Apps Script Web App that stores the leads (see README -> Lead forms).
# Must end in /exec. Without it, the forms fail closed and no lead is captured.
LEAD_WEBHOOK_URL=

# Google Analytics 4 Measurement ID, format G-XXXXXXXXXX.
# Without it, no analytics snippet is emitted at all.
GA4_MEASUREMENT_ID=

# Only used by scripts/generate-blog-images.js, not by the site build.
GEMINI_API_KEY=
